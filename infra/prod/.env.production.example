# Plantilla de producción (ADR-033 §6.1): SOLO nombres de variables, sin valores. Cada sección es un
# archivo del servidor, fuera del repositorio, propiedad de root y con modo 0600, en CRM_ENV_DIR
# (/etc/crm por omisión). Cada destinatario recibe solo el suyo. Copia de todos fuera del servidor
# (ADR-033 §6.2). Nunca se pegan valores en el repo, en issues, en PRs ni en el chat.
# Una variable opcional que no se usa se BORRA del archivo: vacía no es lo mismo que ausente (un
# booleano vacío impide arrancar). «Genera: openssl rand -hex 32» = 64 caracteres hexadecimales nuevos para esa variable.

# ============================== release.env (docker compose --env-file) ==============================
# Sin secretos. Lo escribe deploy.sh (F1-15): referencias por digest, nunca por etiqueta.
# Imagen del backend publicada por CI: ghcr.io/<OWNER>/<REPO>/backend@sha256:<DIGEST> (web, ws, workers, beat, migrate).
BACKEND_IMAGE=
# Imagen del frontend publicada por CI, por digest.
FRONTEND_IMAGE=
# Caddy con caddy-ratelimit (infra/prod/caddy/Dockerfile) publicada por CI, por digest.
PROXY_IMAGE=
# postgres:18.x@sha256:<DIGEST> (la versión mayor de ADR-033 §3).
POSTGRES_IMAGE=
# redis:8.x-alpine@sha256:<DIGEST>.
REDIS_IMAGE=
# El commit de las imágenes (images.yml lo escribe): deploy.sh exige el checkout de infra/prod en él.
REVISION=
# Opcional: directorio de los archivos de abajo (por omisión /etc/crm).
CRM_ENV_DIR=

# ============================== runtime.env (backend, ws, worker, worker-media, beat) ==============================
# Nunca DATABASE_MIGRATOR_URL ni CRM_MIGRATOR_PASSWORD: production no arranca (ADR-002 §1.1).
# compose fija DJANGO_SETTINGS_MODULE y FORWARDED_ALLOW_IPS (la IP de Caddy): no van aquí.
# Genera: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'. Rotarla cierra todas las sesiones.
DJANGO_SECRET_KEY=
# crm.<DOMINIO>,backend (backend: la sonda del frontend por la red interna).
DJANGO_ALLOWED_HOSTS=
# https://crm.<DOMINIO>
DJANGO_CSRF_TRUSTED_ORIGINS=
# https://crm.<DOMINIO>: el origen de los enlaces de los correos (ADR-021 §8).
APP_ORIGIN=
# postgres://crm_app:<CRM_APP_PASSWORD>@postgres:5432/crm (la contraseña de crm_app de postgres.env).
DATABASE_URL=
# ADR-022 §6: <versión>:<32 bytes en base64 urlsafe>. Genera: python3 -c 'import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'. Rotación: ADR-022 §5.
SECRETS_KEKS=
# redis://:<REDIS_PASSWORD>@redis:6379/0 (la contraseña de redis.env).
CELERY_BROKER_URL=
# redis://:<REDIS_PASSWORD>@redis:6379/1 (capa de canales del WebSocket).
CHANNEL_LAYER_REDIS_URL=
# Almacenamiento S3 del propietario (ADR-008, ADR-033 §5): bucket privado y credencial limitada a él.
# https://<ENDPOINT> sin credenciales en la URL; vacío = AWS S3.
STORAGE_ENDPOINT_URL=
# https:// del almacén para las URLs firmadas del navegador; otro host que la app. Vacío = STORAGE_ENDPOINT_URL.
STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Opcional: path (por omisión) o virtual, según el proveedor.
STORAGE_ADDRESSING_STYLE=
# Correo del proveedor SMTP del propietario (ADR-019, ADR-033 §5). Sin EMAIL_HOST no se envía nada.
EMAIL_HOST=
# 587 con EMAIL_USE_TLS=true, o 465 con EMAIL_USE_SSL=true: uno de los dos.
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente en el dominio, verificado con SPF, DKIM y DMARC.
MAIL_FROM=
# Hosts de salida permitidos (core.http), separados por comas; p. ej., graph.facebook.com con WhatsApp.
HTTP_ALLOWED_HOSTS=
# IA (ADR-034 §5): interruptor global; vacío o false = apagada. Cambiarlo pide reiniciar.
AI_ENABLED=
# El tope por persona del copiloto y su plazo van en config/settings/base.py (se cambian por PR).
# WhatsApp (ADR-029): false hasta completar docs/runbooks/whatsapp-activation.md.
META_ENABLED=
# App secret de Meta, de uno a tres separados por comas (el vigente primero). Lo da Meta.
META_APP_SECRETS=
# Genera: openssl rand -hex 32. Se pega también en la configuración del webhook en Meta.
META_WEBHOOK_VERIFY_TOKEN=
# Instagram y Messenger (ADR-035 §7): true solo después de que Meta apruebe la función Human Agent.
META_HUMAN_AGENT_APPROVED=
# Id de la app de Meta (solo dígitos; lo da Meta): reconoce los ecos de Instagram y Messenger.
META_APP_ID=
# Opcionales (ADR-033 decisión 7): sin SENTRY_DSN no hay llamadas de red.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ============================== migrate.env (job migrate) ==============================
# SOLO esta variable (ADR-002 §1.1): postgres://crm_migrator:<CRM_MIGRATOR_PASSWORD>@postgres:5432/crm
DATABASE_MIGRATOR_URL=

# ============================== postgres.env (postgres, solo el primer arranque) ==============================
# La imagen solo las usa al inicializar un volumen vacío (infra/prod/postgres/bootstrap-roles.sh).
# Después del primer arranque correcto se BORRA el archivo y se recrea el contenedor (ADR-033 §6.1).
# Genera cada una: openssl rand -hex 32. El superusuario solo entra por el socket local: pg_hba.conf
# rechaza su acceso por red (backups, ADR-033 §8.1). La imagen exige POSTGRES_PASSWORD para inicializar.
POSTGRES_PASSWORD=
CRM_MIGRATOR_PASSWORD=
CRM_APP_PASSWORD=

# ============================== redis.env (redis) ==============================
# Genera: openssl rand -hex 32 (solo hexadecimal: va entre comillas en la configuración de Redis).
REDIS_PASSWORD=

# ============================== proxy.env (proxy) ==============================
# El dominio sin el prefijo crm. (Caddy sirve crm.<DOMINIO>). No es secreto, pero no va al repo.
CRM_DOMAIN=

# ============================== backup.env (backup.sh y check.sh, temporizadores de root: F1-16) ==============================
# Destino del propietario (ADR-033 §8.2): otro proveedor u otra cuenta; bucket privado con versionado u
# Object Lock y las reglas de infra/prod/backup/lifecycle.json. La credencial del servidor SOLO escribe:
# ni lee, ni lista, ni borra. Runbook: docs/runbooks/backup-restore.md.
# https://<ENDPOINT> sin credenciales en la URL; vacío = AWS S3.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Opcional: claves PÚBLICAS age, una por línea (por omisión, CRM_ENV_DIR/backup-recipients.txt).
BACKUP_RECIPIENTS=
# Opcional: la URL de un servicio externo que avisa si deja de recibir el ping diario (26 h de margen).
BACKUP_HEARTBEAT_URL=
# Opcional: la URL de fallo del mismo servicio (Healthchecks.io y Better Stack: la anterior más /fail).
# backup.sh la llama si falla la noche y check.sh si falta el backup. Las dos llevan el token: secretas.
BACKUP_HEARTBEAT_FAIL_URL=
# Opcionales: Sentry para backup.failed y backup.missing (los mismos valores que en runtime.env).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
