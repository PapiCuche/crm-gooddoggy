# Topología same-origin (ADR-003 §1): un solo origen para el navegador.
# /api, /ws y /webhooks → Django; el resto → Next.js. /health/* no se publica (sondas internas).
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /webhooks/* {
		# Pública y sin sesión: el tope llega antes que Django, que con ASGI lee el cuerpo entero.
		# 4 MB (10^6) cubre los 3 MiB de BODY_MAX en meta_webhook.py (F7-11b) con margen.
		request_body {
			max_size 4MB
		}
		reverse_proxy backend:8000
	}
	handle /ws/* {
		reverse_proxy ws:8000
	}
	handle /health/* {
		respond 404
	}
	handle {
		reverse_proxy frontend:3000
	}
}
