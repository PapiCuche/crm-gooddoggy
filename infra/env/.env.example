# Copiar a infra/env/.env (no versionado) y completar valores locales.
# NUNCA poner aquí credenciales reales de producción.

# --- PostgreSQL (superusuario solo para el init del contenedor) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-superuser

# --- Roles de aplicación (ADR-002) ---
CRM_DB_NAME=crm
CRM_MIGRATOR_PASSWORD=change-me-local-migrator
CRM_APP_PASSWORD=change-me-local-app

# --- Cadenas de conexión que usará el backend (Fase 1) ---
# En producción: web/worker/ws/beat reciben SOLO DATABASE_URL (crm_app);
# DATABASE_MIGRATOR_URL solo existe en el job de migraciones (ADR-002 §1.1).
# En local conviven ambas por comodidad (sin datos reales).
# DATABASE_URL=postgres://crm_app:change-me-local-app@localhost:5432/crm
# DATABASE_MIGRATOR_URL=postgres://crm_migrator:change-me-local-migrator@localhost:5432/crm
# REDIS_URL=redis://localhost:6379/0

# --- Object storage local: Garage v2.4.1 (ADR-008, ADR-012 §6) ---
# Generar valores propios (nunca reutilizar fuera de local):
#   GARAGE_RPC_SECRET=$(openssl rand -hex 32)
#   STORAGE_ACCESS_KEY_ID=GK$(openssl rand -hex 16)
#   STORAGE_SECRET_ACCESS_KEY=$(openssl rand -hex 32)
# Vacías a propósito: compose no arranca hasta que se generen (Garage exige 32 bytes hex).
GARAGE_RPC_SECRET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=crm-local
# Backend: STORAGE_BACKEND=s3, STORAGE_ENDPOINT_URL=http://localhost:3900, STORAGE_REGION=garage

# --- Red del stack. Cambiarla solo si choca con otra red de Docker de tu máquina ---
# STACK_SUBNET=172.31.250.0/24
# STACK_IP_RANGE=172.31.250.128/25   # direcciones que Docker reparte a los servicios
# STACK_PROXY_IP=172.31.250.2        # fija, fuera de ese rango: la única de la que el backend acepta X-Forwarded-For

# --- Puertos del host (solo 127.0.0.1). Cambiarlos si ya están ocupados en tu máquina ---
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# GARAGE_HOST_PORT=3900
# PROXY_HOST_PORT=8080   # la aplicación: http://localhost:8080
# MAILPIT_UI_HOST_PORT=8025
# MAILPIT_SMTP_HOST_PORT=1025

# --- Correo saliente (ADR-019). En local no hace falta nada: compose apunta a Mailpit ---
# En producción, las da el proveedor SMTP que elija el despliegue (nunca se versionan):
#   EMAIL_HOST, EMAIL_PORT (587), EMAIL_HOST_USER, EMAIL_HOST_PASSWORD,
#   EMAIL_USE_TLS=true (STARTTLS) o EMAIL_USE_SSL=true (465), MAIL_FROM
# Y el origen público de la aplicación, con el que se componen los enlaces de un correo
# (ADR-021). En local lo pone compose; en producción es obligatorio con correo, y https:
#   APP_ORIGIN=https://app.example.com
